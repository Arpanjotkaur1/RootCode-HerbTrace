# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real keys.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
# Find it in: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe for client-side use, respects Row Level Security)
# Find it in: Supabase dashboard -> Project Settings -> API -> "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-SIDE ONLY, bypasses Row Level Security)
# Used only in API routes (src/app/api/**). Never expose this to the browser.
# Find it in: Supabase dashboard -> Project Settings -> API -> "service_role"
SUPABASE_SERVICE_ROLE_KEY=

# Frontend base URL for QR codes and provenance links.
# Optional: if unset, api/qr and api/certificate fall back to the real
# deployed frontend (https://rootcode-trace.vercel.app), never localhost --
# a localhost fallback would make every QR code unscannable by anyone but
# the machine running it. Only set this locally if you're pointing at a
# frontend dev server on your own machine (e.g. http://localhost:8080).
FRONTEND_BASE_URL=
